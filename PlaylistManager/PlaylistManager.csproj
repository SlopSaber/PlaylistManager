          <Private>False</Private>
      </Reference>
      <Reference Include="BeatSaber.ViewSystem">
        <HintPath>$(GameDirectory)\Beat Saber_Data\Managed\BeatSaber.ViewSystem.dll</HintPath>
	    <Publicize>True</Publicize>
